config main 'main'
	option enabled '1'
	option mode 'redirect'
	option active_node 'node1'
	option socks_port '10808'
	option redir_port '1081'
	option routing_mode 'bypass_lan'
	option proxy_router '1'
	option hijack_dns '1'
	list direct_domain 'ir'
	list direct_domain 'aparat.com'
	list proxy_domain 'google.com'
	list proxy_domain 'youtube.com'
	list proxy_domain 'twitter.com'

config node 'node1'
	option remark 'Example (VLESS-XHTTP)'
	option type 'vless'
	option server 'example.com'
	option port '443'
	option uuid '00000000-0000-0000-0000-000000000000'
	option transport 'xhttp'
	option security 'tls'
	option sni 'example.com'
	option fp 'chrome'
	option alpn 'h2,http/1.1'
	option host 'example.com'
	option path '/api/1'
	option mode 'stream-up'
	option extra '{"xPaddingBytes":"100-1000"}'
	option raw_link 'vless://00000000-0000-0000-0000-000000000000@example.com:443?encryption=none&security=tls&sni=example.com&fp=chrome&alpn=h2%2Chttp%2F1.1&type=xhttp&host=example.com&path=%2Fapi%2F1&mode=stream-up#Example-Node'

