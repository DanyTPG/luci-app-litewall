config main 'main'
	option enabled '1'
	option mode 'redirect'
	option active_node 'node1'
	option socks_port '10808'
	option redir_port '1081'
	option routing_mode 'rules'
	option proxy_router '1'
	option hijack_dns '1'

config rule_group 'Iran'
	option remarks 'Iran (Domestic)'
	option enabled '1'
	option target_node '_direct'
	option network 'tcp,udp'
	list ip_list 'geoip:ir'
	list domain_list 'geosite:ir'

config rule_group 'GFW'
	option remarks 'GFW (Blocked)'
	option enabled '1'
	option target_node '_default'
	option network 'tcp,udp'
	list domain_list 'geosite:social'
	list domain_list 'geosite:youtube'
	list domain_list 'geosite:x'
	list domain_list 'domain:discord.com'
	list domain_list 'domain:discord.gg'
	list domain_list 'custom.example.com'
	list ip_list 'geoip:telegram'
	list ip_list 'geoip:google'
	list ip_list 'geoip:twitter'
	list ip_list '198.51.100.1'

config rule_group 'Sanction'
	option remarks 'Sanctioned Services'
	option enabled '1'
	option target_node '_default'
	option network 'tcp,udp'
	list domain_list 'geosite:sanctioned'

config rule_group 'ADS'
	option remarks 'Ad Blocking'
	option enabled '1'
	option target_node '_direct'
	option network 'tcp,udp'
	list domain_list 'geosite:category-ads-all'

config rule_group 'ProxyGame'
	option remarks 'ProxyGame (Steam & Gaming)'
	option enabled '1'
	option target_node '_default'
	list domain_list 'geosite:category-games'
	list domain_list 'steamcommunity.com'
	list domain_list 'store.steampowered.com'

config rule_group 'NSFW'
	option remarks 'NSFW (Adult Content)'
	option enabled '0'
	option target_node '_default'
	option network 'tcp,udp'
	list ip_list '198.51.100.2'
	list domain_list 'regexp:.*porn.*'
	list domain_list 'regexp:.*sex.*'

config node 'node1'
	option remark 'Example (VLESS-XHTTP)'
	option type 'vless'
	option server 'example.com'
	option port '443'
	option uuid '00000000-0000-0000-0000-000000000000'
	option transport 'xhttp'
	option security 'tls'
	option sni 'example.com'
	option fp 'chrome'
	option alpn 'h2,http/1.1'
	option host 'example.com'
	option path '/api/1'
	option mode 'stream-up'
	option extra '{"xPaddingBytes":"100-1000"}'
	option raw_link 'vless://00000000-0000-0000-0000-000000000000@example.com:443?encryption=none&security=tls&sni=example.com&fp=chrome&alpn=h2%2Chttp%2F1.1&type=xhttp&host=example.com&path=%2Fapi%2F1&mode=stream-up#Example-Node'

