#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/xray-rust
CONF_DIR=/var/etc/xray-rust
CONF_FILE=$CONF_DIR/config.json
GEN_SCRIPT=/usr/share/xray-rust/generate_config.lua

start_service() {
	local enabled mode redir_port proxy_router hijack_dns watchdog
	config_load xray-rust
	config_get_bool enabled main enabled 0
	config_get mode main mode "redirect"
	config_get redir_port main redir_port "1081"
	config_get_bool proxy_router main proxy_router 0
	config_get_bool hijack_dns main hijack_dns 1
	config_get_bool block_quic main block_quic 1
	config_get_bool watchdog main watchdog 1

	# Sync crontab watchdog entry
	local cron_file="/etc/crontabs/root"
	mkdir -p /etc/crontabs
	touch "$cron_file"
	if [ "$watchdog" -eq 1 ]; then
		if ! grep -q "/usr/share/xray-rust/watchdog.sh" "$cron_file"; then
			echo "* * * * * /usr/share/xray-rust/watchdog.sh" >> "$cron_file"
			/etc/init.d/cron restart >/dev/null 2>&1
		fi
	else
		if grep -q "/usr/share/xray-rust/watchdog.sh" "$cron_file"; then
			sed -i '\#/usr/share/xray-rust/watchdog.sh#d' "$cron_file"
			/etc/init.d/cron restart >/dev/null 2>&1
		fi
	fi

	[ "$enabled" -eq 1 ] || {
		stop_service
		return 0
	}

	[ -x "$PROG" ] || {
		logger -t xray-rust "Binary $PROG not found or not executable"
		return 1
	}

	mkdir -p "$CONF_DIR"
	lua "$GEN_SCRIPT" "$CONF_FILE" >/dev/null 2>&1
	[ $? -eq 0 ] || {
		logger -t xray-rust "Failed to generate configuration file"
		return 1
	}

	# Validate configuration before launching
	$PROG config check -config "$CONF_FILE" >/dev/null 2>&1
	[ $? -eq 0 ] || {
		logger -t xray-rust "Configuration failed validation"
		return 1
	}

	# Apply firewall and DNS configuration before starting daemon
	if [ "$mode" = "redirect" ]; then
		/usr/share/xray-rust/nftables.sh start "$redir_port" "$proxy_router" "$hijack_dns" "$block_quic"
		
		# Configure dnsmasq to forward non-domestic queries to clean DNS
		local upstream_dns=$(uci -q get dhcp.@dnsmasq[0].server | awk '{print $1}')
		[ -z "$upstream_dns" ] && upstream_dns="192.168.100.1"
		for d in /tmp/dnsmasq.*.d; do
			if [ -d "$d" ]; then
				cat <<EOF > "$d/xray-rust.conf"
server=/ir/$upstream_dns
EOF
				if [ -f /var/etc/xray-rust/node_domains ]; then
					for dom in $(cat /var/etc/xray-rust/node_domains); do
						echo "server=/$dom/$upstream_dns" >> "$d/xray-rust.conf"
					done
				fi
				cat <<EOF >> "$d/xray-rust.conf"
server=127.0.0.1#5335
no-resolv
EOF
			fi
		done
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	else
		/usr/share/xray-rust/nftables.sh stop >/dev/null 2>&1
		rm -f /tmp/dnsmasq.*.d/xray-rust.conf 2>/dev/null
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi

	procd_open_instance "xray-rust"
	procd_set_param command "$PROG" run -config "$CONF_FILE"

	if [ "$mode" = "redirect" ]; then
		local redir_idle
		config_get redir_idle main redir_idle "60"
		procd_set_param env XRAY_REDIR_PORT="$redir_port" XRAY_DNS_PORT="5335" XRAY_REDIR_IDLE_TIMEOUT="$redir_idle"
	fi

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	logger -t xray-rust "Service started (mode: $mode)"
}

stop_service() {
        /usr/share/xray-rust/nftables.sh stop >/dev/null 2>&1
        rm -f /tmp/dnsmasq.*.d/xray-rust.conf 2>/dev/null
        /etc/init.d/dnsmasq restart >/dev/null 2>&1
        logger -t xray-rust "Service stopped"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "xray-rust"
}
