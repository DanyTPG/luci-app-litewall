#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/xray-rust
CONF_DIR=/var/etc/xray-rust
CONF_FILE=$CONF_DIR/config.json
GEN_SCRIPT=/usr/share/xray-rust/generate_config.lua

start_service() {
	local enabled mode redir_port proxy_router hijack_dns
	config_load xray-rust
	config_get_bool enabled main enabled 0
	config_get mode main mode "redirect"
	config_get redir_port main redir_port "1081"
	config_get_bool proxy_router main proxy_router 0
	config_get_bool hijack_dns main hijack_dns 1

	[ "$enabled" -eq 1 ] || {
		/usr/share/xray-rust/nftables.sh stop >/dev/null 2>&1
		logger -t xray-rust "Service disabled in config; removed nftables rules"
		return 0
	}

	[ -x "$PROG" ] || {
		logger -t xray-rust "Binary $PROG not found or not executable"
		return 1
	}

	mkdir -p "$CONF_DIR"
	lua "$GEN_SCRIPT" "$CONF_FILE" >/dev/null 2>&1
	[ $? -eq 0 ] || {
		logger -t xray-rust "Failed to generate configuration file"
		return 1
	}

	# Validate configuration before launching
	$PROG config check -config "$CONF_FILE" >/dev/null 2>&1
	[ $? -eq 0 ] || {
		logger -t xray-rust "Configuration failed validation"
		return 1
	}

	procd_open_instance
	procd_set_param command $PROG run -config $CONF_FILE

	if [ "$mode" = "redirect" ]; then
		procd_set_param env XRAY_REDIR_PORT="$redir_port"
		/usr/share/xray-rust/nftables.sh start "$redir_port" "$proxy_router" "$hijack_dns"
	else
		/usr/share/xray-rust/nftables.sh stop >/dev/null 2>&1
	fi

	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	logger -t xray-rust "Service started (mode: $mode)"
}

stop_service() {
	/usr/share/xray-rust/nftables.sh stop >/dev/null 2>&1
	logger -t xray-rust "Service stopped; removed nftables rules"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "xray-rust"
}
