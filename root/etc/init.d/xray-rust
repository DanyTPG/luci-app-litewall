#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/xray-rust
CONF_DIR=/var/etc/xray-rust
CONF_FILE=$CONF_DIR/config.json
GEN_SCRIPT=/usr/share/xray-rust/generate_config.lua

start_service() {
	local enabled mode redir_port proxy_router hijack_dns block_quic watchdog bypass_iran_firewall
	config_load xray-rust
	config_get_bool enabled main enabled 0
	config_get mode main mode "redirect"
	config_get redir_port main redir_port "1081"
	config_get_bool proxy_router main proxy_router 0
	config_get_bool hijack_dns main hijack_dns 1
	config_get_bool block_quic main block_quic 1
	config_get_bool watchdog main watchdog 1
	config_get_bool bypass_iran_firewall main bypass_iran_firewall 1

	# Sync crontab watchdog entry
	local cron_file="/etc/crontabs/root"
	mkdir -p /etc/crontabs
	touch "$cron_file"
	if [ "$watchdog" -eq 1 ]; then
		if ! grep -q "/usr/share/xray-rust/watchdog.sh" "$cron_file"; then
			echo "* * * * * /usr/share/xray-rust/watchdog.sh" >> "$cron_file"
			/etc/init.d/cron restart >/dev/null 2>&1
		fi
	else
		if grep -q "/usr/share/xray-rust/watchdog.sh" "$cron_file"; then
			sed -i '\#/usr/share/xray-rust/watchdog.sh#d' "$cron_file"
			/etc/init.d/cron restart >/dev/null 2>&1
		fi
	fi

	[ "$enabled" -eq 1 ] || {
		stop_service
		return 0
	}

	[ -x "$PROG" ] || {
		logger -t xray-rust "Binary $PROG not found or not executable"
		return 1
	}

	mkdir -p "$CONF_DIR"
	lua "$GEN_SCRIPT" "$CONF_FILE" >/dev/null 2>&1
	[ $? -eq 0 ] || {
		logger -t xray-rust "Failed to generate configuration file"
		return 1
	}

	# Validate configuration before launching
	$PROG config check -config "$CONF_FILE" >/dev/null 2>&1
	[ $? -eq 0 ] || {
		logger -t xray-rust "Configuration failed validation"
		return 1
	}

	# Apply firewall and DNS configuration before starting daemon
	if [ "$mode" = "redirect" ]; then
		/usr/share/xray-rust/nftables.sh start "$redir_port" "$proxy_router" "$hijack_dns" "$block_quic" "$bypass_iran_firewall"
		
		# Configure dnsmasq to forward non-domestic queries to clean DNS
		local domestic_dns
		config_get domestic_dns main domestic_dns ""
		if [ -z "$domestic_dns" ]; then
			domestic_dns=$(uci -q get dhcp.@dnsmasq[0].server | awk '{print $1}')
			[ -z "$domestic_dns" ] && domestic_dns="192.168.100.1"
		fi

		local remote_dns
		config_get remote_dns main remote_dns "8.8.8.8"
		[ -z "$remote_dns" ] && remote_dns="8.8.8.8"

		for d in /tmp/dnsmasq.*.d; do
			if [ -d "$d" ]; then
				cat <<EOF > "$d/xray-rust.conf"
server=/ir/$domestic_dns
EOF
				if [ -f /var/etc/xray-rust/node_domains ]; then
					for dom in $(cat /var/etc/xray-rust/node_domains); do
						echo "server=/$dom/$domestic_dns" >> "$d/xray-rust.conf"
					done
				fi
				cat <<EOF >> "$d/xray-rust.conf"
server=127.0.0.1#5335
no-resolv
EOF
			fi
		done
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	else
		/usr/share/xray-rust/nftables.sh stop >/dev/null 2>&1
		rm -f /tmp/dnsmasq.*.d/xray-rust.conf 2>/dev/null
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi

	procd_open_instance "xray-rust"
	procd_set_param command "$PROG" run -config "$CONF_FILE"

	local worker_threads
	config_get worker_threads main worker_threads ""

	if [ "$mode" = "redirect" ]; then
		local redir_idle
		config_get redir_idle main redir_idle "60"
		local env_args="XRAY_REDIR_PORT=$redir_port XRAY_DNS_PORT=5335 XRAY_REDIR_IDLE_TIMEOUT=$redir_idle XRAY_DOMESTIC_DNS=$domestic_dns:53 XRAY_REMOTE_DNS=$remote_dns:53"
		[ -n "$worker_threads" ] && env_args="$env_args TOKIO_WORKER_THREADS=$worker_threads"
		procd_set_param env $env_args
	elif [ -n "$worker_threads" ]; then
		procd_set_param env TOKIO_WORKER_THREADS="$worker_threads"
	fi

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	get_runtime_fp > "$CONF_DIR/runtime_fp"
	logger -t xray-rust "Service started (mode: $mode)"
}

get_runtime_fp() {
	local enabled mode redir_port socks_port proxy_router hijack_dns block_quic bypass_iran_firewall domestic_dns remote_dns worker_threads redir_idle
	config_load xray-rust
	config_get enabled main enabled "0"
	config_get mode main mode "redirect"
	config_get redir_port main redir_port "1081"
	config_get socks_port main socks_port "10808"
	config_get proxy_router main proxy_router "0"
	config_get hijack_dns main hijack_dns "1"
	config_get block_quic main block_quic "1"
	config_get bypass_iran_firewall main bypass_iran_firewall "1"
	config_get domestic_dns main domestic_dns "192.168.100.1"
	config_get remote_dns main remote_dns "8.8.8.8"
	config_get worker_threads main worker_threads ""
	config_get redir_idle main redir_idle "60"
	echo "${enabled}:${mode}:${redir_port}:${socks_port}:${proxy_router}:${hijack_dns}:${block_quic}:${bypass_iran_firewall}:${domestic_dns}:${remote_dns}:${worker_threads}:${redir_idle}"
}

stop_service() {
        /usr/share/xray-rust/nftables.sh stop >/dev/null 2>&1
        rm -f /tmp/dnsmasq.*.d/xray-rust.conf 2>/dev/null
        rm -f "$CONF_DIR/runtime_fp" 2>/dev/null
        /etc/init.d/dnsmasq restart >/dev/null 2>&1
        logger -t xray-rust "Service stopped"
}

reload_service() {
	config_load xray-rust
	local enabled
	config_get enabled main enabled "0"
	if [ "$enabled" != "1" ]; then
		stop
		return 0
	fi

	# If service is not currently running, start it
	if ! pgrep -f "$PROG run" >/dev/null; then
		start
		return 0
	fi

	local check_dir="/tmp/xray-rust-check"
	rm -rf "$check_dir"
	mkdir -p "$check_dir"

	lua "$GEN_SCRIPT" "$check_dir/config.json" >/dev/null 2>&1
	if [ $? -ne 0 ]; then
		logger -t xray-rust "Failed to generate configuration during reload"
		rm -rf "$check_dir"
		return 1
	fi

	# Check if core config or runtime settings changed
	local changed=0
	if [ ! -f "$CONF_FILE" ] || ! cmp -s "$check_dir/config.json" "$CONF_FILE"; then
		changed=1
	elif [ -f "$check_dir/server_ips" ] && [ -f "$CONF_DIR/server_ips" ] && ! cmp -s "$check_dir/server_ips" "$CONF_DIR/server_ips"; then
		changed=1
	elif [ -f "$check_dir/node_domains" ] && [ -f "$CONF_DIR/node_domains" ] && ! cmp -s "$check_dir/node_domains" "$CONF_DIR/node_domains"; then
		changed=1
	elif [ -f "$check_dir/lan_bypass" ] && [ -f "$CONF_DIR/lan_bypass" ] && ! cmp -s "$check_dir/lan_bypass" "$CONF_DIR/lan_bypass"; then
		changed=1
	fi

	local cur_fp
	local new_fp
	[ -f "$CONF_DIR/runtime_fp" ] && cur_fp=$(cat "$CONF_DIR/runtime_fp")
	new_fp=$(get_runtime_fp)
	if [ "$cur_fp" != "$new_fp" ]; then
		changed=1
	fi

	if [ "$changed" -eq 0 ]; then
		logger -t xray-rust "Active configuration unchanged (inactive nodes/rules edited), skipping daemon restart"
		rm -rf "$check_dir"
		return 0
	fi

	rm -rf "$check_dir"
	logger -t xray-rust "Active configuration changed, reloading service"
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "xray-rust"
}
